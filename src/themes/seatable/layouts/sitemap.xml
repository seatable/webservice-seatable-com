{{- if hugo.IsProduction -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?><?xml-stylesheet type=\"text/xsl\" href=\"/main-sitemap.xsl\"?>" | safeHTML }}
  <sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {{- /* Order: core pages first, private topics (lifestyle) last */}}
    {{- range slice "page" "post" "help" "template" "lifestyle" }}
    <sitemap>
      <loc>{{ print site.BaseURL site.Language.Lang "/" . "-sitemap.xml" }}</loc>
      {{- range sort (partial "sitemap/pages.html" .) "Lastmod" "desc" | first 1 }}
        <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
      {{- end }}
    </sitemap>
    {{- end }}
  </sitemapindex>
{{ end }}
